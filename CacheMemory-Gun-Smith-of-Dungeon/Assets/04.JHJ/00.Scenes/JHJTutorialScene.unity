  - {fileID: -8578684495055133663, guid: a160cf19428934044bee4643c2ddc311, type: 3}
  - {fileID: -2676193522479020288, guid: c3f6517565a3586489ff0187c8bca509, type: 3}
  - {fileID: -2676193522479020288, guid: c3f6517565a3586489ff0187c8bca509, type: 3}
  - {fileID: -2676193522479020288, guid: c3f6517565a3586489ff0187c8bca509, type: 3}
  - {fileID: -2676193522479020288, guid: c3f6517565a3586489ff0187c8bca509, type: 3}
  - {fileID: -2676193522479020288, guid: c3f6517565a3586489ff0187c8bca509, type: 3}
  - {fileID: -2676193522479020288, guid: c3f6517565a3586489ff0187c8bca509, type: 3}
  descriptions:
  - "\uD29C\uD1A0\uB9AC\uC5BC\uC785\uB2C8\uB2E4. \uC2A4\uD0B5 \uD558\uB824\uBA74
    \uC2A4\uD398\uC774\uC2A4\uBC14\uB97C \uB20C\uB7EC\uC8FC\uC138\uC694."
  - "\uCC98\uC74C \uAC8C\uC784\uC5D0 \uB4E4\uC5B4\uC654\uC744 \uB54C \uD654\uBA74\uC785\uB2C8\uB2E4."
  - "Play \uBC84\uD2BC\uC744 \uB20C\uB7EC \uCE90\uB9AD\uD130 \uC120\uD0DD\uC774 \uAC00\uB2A5\uD569\uB2C8\uB2E4."
  - "Play \uBC84\uD2BC \uC606 \uBC30\uB0AD \uBC84\uD2BC\uC744 \uB204\uB974\uC2DC\uBA74"
  - "\uC778\uBCA4\uD1A0\uB9AC \uD654\uBA74\uC5D0 \uC9C4\uC785\uD569\uB2C8\uB2E4."
  - "\uC5EC\uAE30\uC11C \uC624\uB978\uCABD\uC5D0 \uC788\uC744 \uD30C\uCE20 \uC544\uC774\uD15C\uC744
    \uB04C\uACE0 \uC640 \uC7A5\uCC29 \uAC00\uB2A5\uD569\uB2C8\uB2E4."
  - "\uC774\uACF3\uC740 \uC81C\uC791 \uD654\uBA74\uC778\uB370\uC694."
  - "\uC7AC\uB8CC\uC758 \uC885\uB958\uC640 \uAC1C\uC218\uC5D0 \uB9DE\uB294 \uD30C\uCE20\uB97C
    \uACE0\uB974\uACE0 \uC81C\uC791 \uAC00\uB2A5\uD569\uB2C8\uB2E4."
  - "\uC870\uC791\uD0A4\uB97C \uC54C\uB824\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
  - "W, A, S, D -> \uC774\uB3D9"
  - "\uC88C\uD074\uB9AD -> \uACF5\uACA9"
  - "Tab-> \uBC30\uB0AD \uC5F4\uAE30, \uB2EB\uAE30"
  - "\uC5EC\uAE30\uAE4C\uC9C0 \uAE30\uBCF8\uC801\uC778 \uC870\uC791\uBC29\uBC95\uAE4C\uC9C0
    \uB05D\uB0AC\uC2B5\uB2C8\uB2E4."
  - "\uC2A4\uD398\uC774\uC2A4\uBC14\uB97C \uB20C\uB7EC \uAC8C\uC784\uC744 \uC2DC\uC791\uD574\uC8FC\uC138\uC694."
  tutorialImage: {fileID: 1759103289}
  tutorialText: {fileID: 1610763637}
  nextKey: 13
  prevKey: 8
  loop: 0
